# Values prefixed with REACT_APP_ are embedded in the browser bundle.
# Never put private API keys or server-side credentials in this file.
REACT_APP_SITE_URL=http://localhost:3000

# Optional same-origin, privacy-conscious telemetry collectors. Leave blank to transmit nothing.
REACT_APP_ANALYTICS_ENDPOINT=
REACT_APP_WEB_VITALS_ENDPOINT=

# Server-only Vercel function variables. Configure these in the deployment platform, never in client code.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Source maps can be enabled in CI for private monitoring uploads.
GENERATE_SOURCEMAP=false
